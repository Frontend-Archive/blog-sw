# Auth.js — https://authjs.dev/getting-started/installation
# openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App
# Homepage URL: https://<배포 도메인>
# Authorization callback URL: https://<배포 도메인>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 글을 등록할 수 있는 스터디 멤버. GitHub 로그인 아이디 → archive 의 author 이름
ARCHIVE_MEMBERS={"github-id":"이름"}

# GitHub API rate limit 회피 및 archive 레포로 dispatch 를 보낼 때 사용
# repo 스코프 PAT
GITHUB_TOKEN=

# archive 레포 위치를 바꿀 때만 설정 (기본값: Frontend-Archive/archive@main)
# ARCHIVE_REPO_OWNER=
# ARCHIVE_REPO_NAME=
# ARCHIVE_REPO_PATH=
# ARCHIVE_REPO_REF=

# 글 등록(/submit)에만 필요하다. 없으면 그 페이지가 안내로 대체되고,
# 나머지 화면은 content/archive.json 만으로 그대로 돈다.

# Auth.js 세션 서명 키 — openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App — Settings > Developer settings > OAuth Apps
# Authorization callback URL: https://<배포 도메인>/api/auth/callback/github
# 콜백은 앱당 하나뿐이라 로컬용과 배포용을 따로 만든다.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# archive 레포로 등록 요청을 보낼 때 쓴다. Contents 쓰기 권한이 필요하다.
# 없어도 사이트는 돌지만 pnpm sync 가 GitHub API 시간당 제한에 걸릴 수 있다.
GITHUB_TOKEN=
